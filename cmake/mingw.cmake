set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(MUFF_SYSROOT /workspace/sysroot CACHE PATH "Extracted MinGW toolchain root")
set(CMAKE_C_COMPILER "${MUFF_SYSROOT}/usr/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "${MUFF_SYSROOT}/usr/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "${MUFF_SYSROOT}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MUFF_SYSROOT}/usr/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libgcc -static-libstdc++ -static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static-libgcc -static-libstdc++ -static")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-static-libgcc -static-libstdc++ -static")

set(CMAKE_CXX_FLAGS_INIT "-I/workspace/tools/win-headers")
set(CMAKE_CROSSCOMPILING_EMULATOR /workspace/tools/wine CACHE FILEPATH "Wine wrapper for tests and VST3 manifest generation")
